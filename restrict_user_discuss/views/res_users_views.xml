<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_restrict_apps" model="ir.ui.view">
        <field name="name">res.users.form.inherit.restrict.apps</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Controlo de Visibilidade de Aplicações" groups="base.group_system">
                    <field name="specific_visible_app_ids" widget="many2many_tags" placeholder="Selecione as aplicações permitidas para este utilizador..."/>
                    <field name="allowed_app_ids" widget="many2many_tags" readonly="1" string="Aplicações Finais Permitidas (Resumo)"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
