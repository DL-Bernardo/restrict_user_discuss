<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_groups_form_inherit_restrict_apps" model="ir.ui.view">
        <field name="name">res.groups.form.inherit.restrict.apps</field>
        <field name="model">res.groups</field>
        <field name="inherit_id" ref="base.view_groups_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='users']" position="before">
                <field name="visible_app_ids" widget="many2many_tags" placeholder="e.g. Sales, Invoicing, Discuss..."/>
            </xpath>
        </field>
    </record>
</odoo>
